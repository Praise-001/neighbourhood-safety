# Supabase configuration (get from your Supabase project dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key for administrative operations and database seeding (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Site URL for Auth redirects (e.g. https://neighbourhood-safety-app.vercel.app or http://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://neighbourhood-safety-app.vercel.app
NEXT_PUBLIC_APP_URL=https://neighbourhood-safety-app.vercel.app
