# Copy to .env. NEVER commit .env. All values below are placeholders.
# Validated at boot by apps/api/src/config (zod). Missing/invalid → process exits.

# --- General ---
NODE_ENV=development
APP_NAME=SafeNeighbour
LOG_LEVEL=info
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://app_api:changeme@localhost:5432/safeneighbour
DATABASE_MIGRATOR_URL=postgresql://app_migrator:changeme@localhost:5432/safeneighbour
DB_STATEMENT_TIMEOUT_MS=5000
DB_POOL_MAX=20

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ACTIVE_KID=k1
JWT_PRIVATE_KEY_K1=            # PEM, from secret manager in non-local envs
JWT_PUBLIC_KEY_K1=
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
MAGIC_LINK_TTL_SECONDS=900
COOKIE_DOMAIN=localhost
CSRF_SECRET=

# --- Encryption (column-level) ---
DATA_ENCRYPTION_KEY_ID=dek1
DATA_ENCRYPTION_KEY_DEK1=      # 32 bytes base64; KMS-wrapped in prod
HASH_PEPPER=                   # for email/phone lookup hashes

# --- Messaging ---
SMS_PROVIDER=termii            # termii | twilio
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_ALLOWED_COUNTRY_CODES=NG
SMS_DAILY_BUDGET_CAP=100
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
SMTP_HOST=localhost            # Mailpit in local
SMTP_PORT=1025

# --- Push ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.example.safeneighbour

# --- Storage / media ---
S3_ENDPOINT=http://localhost:9000   # MinIO local
S3_REGION=us-east-1
S3_BUCKET_MEDIA=safeneighbour-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=50
MEDIA_MAX_VIDEO_SECONDS=30
CDN_BASE_URL=
MALWARE_SCAN_PROVIDER=clamav        # clamav | provider | none(local only)
MODERATION_PROVIDER=none            # none | provider

# --- Maps / geocoding ---
MAP_TILE_STYLE_URL=
GEOCODING_PROVIDER=
GEOCODING_API_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=          # public values only for NEXT_PUBLIC_/EXPO_PUBLIC_

# --- Rate limits (per window) ---
RL_OTP_PER_IDENTIFIER_HOUR=5
RL_OTP_PER_IP_HOUR=20
RL_TICKET_CREATE_PER_USER_HOUR=10
RL_TICKET_CREATE_PER_DEVICE_HOUR=15
RL_GUEST_LOOKUP_PER_IP_HOUR=20

# --- Feature flags (defaults) ---
FF_PASSKEYS=false
FF_BUSINESS_SSO=false
FF_VIDEO_UPLOAD=true
FF_PUSH_FANOUT=true            # kill switch
FF_UPLOADS=true                # kill switch

# --- Observability ---
SENTRY_DSN=
POSTHOG_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
